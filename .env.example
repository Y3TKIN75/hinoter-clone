# Groq API anahtarınızı https://console.groq.com/keys adresinden alın
GROQ_API_KEY=gsk_...

# Sunucu portu
PORT=3001

# Modeller (bkz. https://console.groq.com/docs/models)
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# LLM'e tek çağrıda gönderilecek maksimum transkript token bütçesi.
# Free tier (8.000 TPM) için 5000; Developer tier için 100000 yapabilirsiniz.
LLM_INPUT_BUDGET=5000
